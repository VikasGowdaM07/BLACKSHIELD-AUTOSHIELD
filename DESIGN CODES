```js
    // ========================================================
    // COMMAND CENTER (v3.0)
    // ========================================================
    let ccFailed = new Set(), ccChain = \[], ccTimer = null;
    function toggleTheme(){const r=document.documentElement;r.dataset.theme=r.dataset.theme==='light'?'dark':'light';}
    const esc = t => String(t).replace(/\[\&<>"]/g, c => ({'\&':'\&amp;','<':'\&lt;','>':'\&gt;','"':'\&quot;'}\[c]));

    function ccRefresh(){
      if(!blackoutState) return;
      const acc = blackoutState.accepted;
      ccFailed = new Set(\[...ccFailed].filter(id => acc.some(a => a.service\_id === id)));
      document.getElementById('cc-budget').innerText = currentPowerBudget;
      ccSweep(acc); ccFailUI(acc); ccBuildChain().then(()=>ccVerify(false,true)); ccSitrep();
    }

    function ccSweep(acc){
      const pts=\[]; for(let b=1;b<=20;b++){const r=runSimulation(acc,b);pts.push({b,n:r.summary.restored\_count,kw:r.summary.power\_used\_kw});}
      const total=acc.length, W=560,H=170,L=30,B=24;
      const x=b=>L+(b-1)\*(W-L-10)/19, y=n=>H-B-(total?n/total:0)\*(H-B-12);
      const line=pts.map((p,i)=>(i?'L':'M')+x(p.b)+','+y(p.n)).join(' ');
      const cur=pts\[currentPowerBudget-1];
      const full=pts.find(p=>p.n===total);
      const crit5=acc.filter(a=>a.criticality===5);
      const c5=pts.find(p=>{const r=runSimulation(acc,p.b);return crit5.every(c=>r.recoveryList.find(x=>x.service\_id===c.service\_id).recovery\_result==='RESTORED');});
      document.getElementById('cc-sweep').innerHTML=`<svg viewBox="0 0 ${W} ${H}" class="w-full min-w-\[420px]">
        ${\[0,.5,1].map(f=>`<line x1="${L}" x2="${W-10}" y1="${y(total\*f)}" y2="${y(total\*f)}" stroke="var(--border)" stroke-dasharray="3 3"/><text x="2" y="${y(total\*f)+3}" font-size="9" fill="var(--muted-foreground)">${Math.round(total\*f)}</text>`).join('')}
        <path d="${line}" fill="none" stroke="#f59e0b" stroke-width="2.5"/>
        ${pts.map(p=>`<circle cx="${x(p.b)}" cy="${y(p.n)}" r="${p.b===currentPowerBudget?5:2.5}" fill="${p.b===currentPowerBudget?'#10b981':'#f59e0b'}" style="cursor:pointer" onclick="setBudget(${p.b});document.getElementById('budget-slider').value=${p.b}"><title>${p.b} kW → ${p.n}/${total} restored</title></circle>`).join('')}
        ${pts.filter(p=>p.b%2===0).map(p=>`<text x="${x(p.b)}" y="${H-8}" font-size="9" text-anchor="middle" fill="var(--muted-foreground)">${p.b}</text>`).join('')}
        <text x="${W-10}" y="${H-8}" font-size="9" text-anchor="end" fill="var(--muted-foreground)">kW</text></svg>`;
      document.getElementById('cc-min-badge').innerText = full ? `Full restore ≥ ${full.b} kW` : 'Full restore not reachable';
      const jumps=pts.filter((p,i)=>i\&\&p.n>pts\[i-1].n).map(p=>`${p.b} kW (+${p.n-pts\[p.b-2].n})`);
      document.getElementById('cc-insights').innerHTML=\[
        c5?`• All criticality-5 services are restored from <b class="text-\[var(--foreground)]">${c5.b} kW</b>.`:'• Criticality-5 services cannot all be restored within 20 kW.',
        `• Click any point to jump the budget. Current: <b class="text-\[var(--foreground)]">${cur.n}/${total}</b> restored at ${currentPowerBudget} kW.`,
        jumps.length?`• Biggest steps up: ${jumps.join(', ')}.`:''].filter(Boolean).join('<br>');
    }

    function ccFailUI(acc){
      document.getElementById('cc-fail-list').innerHTML=acc.map(a=>`<button onclick="ccToggleFail('${a.service\_id}')" class="text-\[11px] font-mono px-2 py-1 rounded-lg border ${ccFailed.has(a.service\_id)?'bg-rose-500/15 border-rose-500/50 text-rose-500 line-through':'bg-\[var(--background)] border-\[var(--border)]'}">${esc(a.service\_id)}</button>`).join('');
      const live=acc.filter(a=>!ccFailed.has(a.service\_id));
      const r=runSimulation(live,currentPowerBudget), base=blackoutState.summary.restored\_count;
      const lost=blackoutState.recoveryList.filter(b=>b.recovery\_result==='RESTORED'\&\&!r.recoveryList.some(x=>x.service\_id===b.service\_id\&\&x.recovery\_result==='RESTORED')\&\&!ccFailed.has(b.service\_id));
      document.getElementById('cc-fail-result').innerHTML=ccFailed.size===0?'<span class="text-\[var(--muted-foreground)]">Click a service ID to fail it.</span>':
        `<div>Restored: <b>${r.summary.restored\_count}</b> (baseline ${base}, <span class="${r.summary.restored\_count<base?'text-rose-500':'text-emerald-500'}">${r.summary.restored\_count-base>=0?'+':''}${r.summary.restored\_count-base}</span>)</div>
         <div>Power used: ${r.summary.power\_used\_kw} kW · reserve ${r.summary.remaining\_kw} kW</div>
         <div class="text-rose-500">${lost.length?'Cascade losses: '+lost.map(l=>esc(l.service\_id)).join(', '):'No additional cascade losses.'}</div>
         <button onclick="ccFailed.clear();ccFailUI(blackoutState.accepted)" class="mt-1 text-\[11px] underline text-\[var(--muted-foreground)]">Clear all</button>`;
    }
    function ccToggleFail(id){ccFailed.has(id)?ccFailed.delete(id):ccFailed.add(id);ccFailUI(blackoutState.accepted);}

    function ccReplay(){
      clearInterval(ccTimer); if(!blackoutState) return;
      const tl=blackoutState.timeline, log=document.getElementById('cc-rp-log'), bar=document.getElementById('cc-rp-bar'), bud=currentPowerBudget;
      log.innerHTML=''; bar.style.width='0%'; let i=0;
      if(!tl.length){log.innerHTML='<span class="text-rose-500">Nothing can be restored at this budget.</span>';return;}
      ccTimer=setInterval(()=>{
        if(i>=tl.length){clearInterval(ccTimer);log.insertAdjacentHTML('beforeend',`<span class="text-emerald-500 font-bold">✓ Replay complete: ${tl.length} services restored.</span>`);return;}
        const t=tl\[i++]; bar.style.width=(t.running\_used/bud\*100)+'%';
        log.insertAdjacentHTML('beforeend',`<div class="flex justify-between border border-\[var(--border)] rounded-lg px-2 py-1 bg-\[var(--background)]"><span><b>Step ${t.step}</b> ⚡ ${esc(t.id)} <span class="text-\[var(--muted-foreground)]">(crit ${t.crit})</span></span><span class="font-mono text-amber-500">+${t.power} kW → ${t.running\_used.toFixed(1)}/${bud}</span></div>`);
      },700);
    }

    async function sha256(t){
      try{const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(t));return \[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('');}
      catch(e){let h=2166136261;for(const c of t){h^=c.charCodeAt(0);h=Math.imul(h,16777619);}return ('00000000'+(h>>>0).toString(16)).repeat(8);}
    }
    async function ccBuildChain(){
      let prev='0'.repeat(64); ccChain=\[];
      for(const a of blackoutState.audit){const entry={action:a.action,details:a.details,prev};const hash=await sha256(prev+'|'+a.action+'|'+a.details);ccChain.push({...entry,hash});prev=hash;}
    }
    async function ccVerify(tamper,silent){
      const el=document.getElementById('cc-chain-status'); if(!ccChain.length) return;
      const copy=ccChain.map(c=>({...c})); if(tamper\&\&copy.length>1) copy\[1].details+=' (edited)';
      let prev='0'.repeat(64), bad=-1;
      for(let i=0;i<copy.length;i++){const h=await sha256(prev+'|'+copy\[i].action+'|'+copy\[i].details); if(h!==copy\[i].hash\&\&bad<0) bad=i; prev=copy\[i].hash;}
      document.getElementById('cc-chain').innerHTML=copy.map((c,i)=>`<div class="px-2 py-1 rounded border ${bad>=0\&\&i>=bad?'border-rose-500/50 text-rose-500':'border-\[var(--border)]'}">#${i} ${esc(c.action)} · ${c.hash.slice(0,16)}…</div>`).join('');
      el.className='text-xs font-bold '+(bad<0?'text-emerald-500':'text-rose-500');
      el.innerText=bad<0?`✓ Chain intact (${copy.length} entries, head ${copy\[copy.length-1].hash.slice(0,12)})`:`✗ TAMPER DETECTED at entry #${bad}; entries #${bad}–#${copy.length-1} fail verification`;
      if(!silent) showToast(bad<0?'Ledger verified':'Tamper detected',bad<0);
    }

    function ccSitrepText(){
      const b=blackoutState, sm=b.summary, head=ccChain.length?ccChain\[ccChain.length-1].hash.slice(0,16):'n/a';
      const rs=b.recoveryList.filter(r=>r.recovery\_result==='RESTORED'), un=b.recoveryList.filter(r=>r.recovery\_result!=='RESTORED');
      return `# BlackoutShield SITREP
Generated: ${new Date().toISOString()}
Dataset: ${document.getElementById('bs-file-label').innerText}

## Data trust
- Ingested ${b.rawRows.length} rows · accepted ${b.accepted.length} · quarantined ${b.quarantine.length}
- Ledger head (SHA-256): ${head}

## Recovery at ${sm.backup\_budget\_kw} kW
- Restored ${sm.restored\_count}/${sm.total\_count} · used ${sm.power\_used\_kw} kW · reserve ${sm.remaining\_kw} kW
${rs.map((r,i)=>`  ${i+1}. ${r.service\_id} (${r.service\_name}, crit ${r.criticality}, ${r.power\_kw} kW)`).join('\\n')||'  none'}

## Not restored
${un.map(r=>`- ${r.service\_id}: ${r.recovery\_result}`).join('\\n')||'- none'}

## Quarantined records
${b.quarantine.map(q=>`- Row ${q.raw\_idx} ${q.service\_id||'UNKNOWN'}: ${q.quarantine\_reason}`).join('\\n')||'- none'}
`;}
    function ccSitrep(){document.getElementById('cc-sitrep').innerText=ccSitrepText();}
    function ccCopySitrep(){navigator.clipboard.writeText(ccSitrepText()).then(()=>showToast('SITREP copied'),()=>showToast('Copy blocked by browser',false));}
    function ccDownloadSitrep(){triggerDownload(ccSitrepText(),'sitrep.md','text/markdown');}
```
