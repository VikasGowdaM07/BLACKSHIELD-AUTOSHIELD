  <!-- ======================================================== -->
  <!-- JAVASCRIPT ENGINE (Exact In-Memory Solver)               -->
  <!-- ======================================================== -->
  <script>
    const DEFAULT_SERVICES_CSV = `service_id,service_name,criticality,power_kw,status,depends_on,timestamp
PWR,Backup Power Controller,5,1,ONLINE,,2026-10-29 09:00:00
WIFI,Campus WiFi,3,4,ONLINE,PWR,2026-10-29 09:01:00
CLINIC,First Aid Clinic,5,3,ONLINE,PWR,2026-10-29 09:02:00
COLD,Medicine Refrigerator,5,2,ONLINE,PWR,2026-10-29 09:03:00
ACCESS,Access Control,4,2,ONLINE,PWR,2026-10-29 09:04:00
LIGHTS,Common Area Lights,2,3,ONLINE,PWR,2026-10-29 09:05:00
WIFI,Campus WiFi duplicate,3,4,ONLINE,PWR,2026-10-29 09:06:00
CAMERA,Security Camera,high,1,ONLINE,PWR,not-a-date`;

    let activeBlackoutCSV = DEFAULT_SERVICES_CSV;
    let currentPowerBudget = 8;
    let blackoutState = null;

    function parseCSV(text) {
      const lines = text.trim().split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 0);
      if (lines.length === 0) return [];
      const headers = lines[0].split(',').map(h => h.trim());
      const rows = [];
      for (let i = 1; i < lines.length; i++) {
        const parts = lines[i].split(',').map(p => p.trim());
        const row = {};
        headers.forEach((h, idx) => {
          row[h] = parts[idx] !== undefined ? parts[idx] : "";
        });
        rows.push(row);
      }
      return rows;
    }

    // Engine: Validation & Quarantine
    function validateBlackoutData(rawRows) {
      const audit = [];
      const quarantineIndices = new Set();
      const reasons = {};

      function reject(idx, reason) {
        quarantineIndices.add(idx);
        if (!reasons[idx]) reasons[idx] = [];
        reasons[idx].push(reason);
      }

      const rows = rawRows.map(r => ({ ...r }));

      rows.forEach((row, idx) => {
        ['service_id', 'service_name', 'status', 'depends_on', 'timestamp'].forEach(col => {
          if (row[col]) {
            const trimmed = row[col].trim();
            if (trimmed !== row[col]) {
              audit.push({ action: 'TRIM_WHITESPACE', details: `${col}: trimmed whitespace` });
              row[col] = trimmed;
            }
          }
        });
        row.service_id = (row.service_id || '').toUpperCase();
        row.status = (row.status || '').toUpperCase();
        row.depends_on = (row.depends_on || '').toUpperCase();

        if (!row.service_id) reject(idx, "Missing service_id");
        if (!row.service_name) reject(idx, "Missing service_name");

        const crit = Number(row.criticality);
        if (isNaN(crit) || !Number.isInteger(crit)) {
          reject(idx, "Criticality must be an integer from 1 to 5 (found non-integer)");
        } else if (crit < 1 || crit > 5) {
          reject(idx, "Criticality must be from 1 to 5");
        }

        const pwr = Number(row.power_kw);
        if (isNaN(pwr) || pwr <= 0) {
          reject(idx, "power_kw must be a positive number");
        }

        if (row.status !== "ONLINE" && row.status !== "OFFLINE") {
          reject(idx, "Status must be ONLINE or OFFLINE");
        }

        if (isNaN(Date.parse(row.timestamp))) {
          reject(idx, "Invalid or unparseable timestamp");
        }
      });

      // Duplicates
      const seen = new Set();
      rows.forEach((row, idx) => {
        const sid = row.service_id;
        if (sid) {
          if (seen.has(sid)) {
            reject(idx, `Duplicate service_id: ${sid}`);
          } else {
            seen.add(sid);
          }
        }
      });

      // Dependencies
      const allIds = new Set(rows.map(r => r.service_id).filter(Boolean));
      rows.forEach((row, idx) => {
        const deps = (row.depends_on || '').split(',').map(d => d.trim()).filter(Boolean);
        const unknown = deps.filter(d => !allIds.has(d));
        if (unknown.length > 0) {
          reject(idx, "Unknown dependency ID(s): " + unknown.join(', '));
        }
        if (row.service_id && deps.includes(row.service_id)) {
          reject(idx, "A service cannot depend on itself");
        }
      });

      let accepted = [];
      let quarantine = [];

      rows.forEach((row, idx) => {
        if (quarantineIndices.has(idx)) {
          const reasonStr = (reasons[idx] || ["Unknown validation issue"]).join('; ');
          quarantine.push({ ...row, quarantine_reason: reasonStr, raw_idx: idx + 2 });
          audit.push({ action: 'QUARANTINE_ROW', details: `Row ${idx + 2}: ${reasonStr}` });
        } else {
          accepted.push({
            service_id: row.service_id,
            service_name: row.service_name,
            criticality: parseInt(row.criticality),
            power_kw: parseFloat(row.power_kw),
            status: row.status,
            depends_on: row.depends_on,
            timestamp: row.timestamp
          });
        }
      });

      // Quarantining dependent services
      let acceptedIds = new Set(accepted.map(r => r.service_id));
      let unsafeIndices = [];
      accepted.forEach((row, idx) => {
        const deps = (row.depends_on || '').split(',').map(d => d.trim()).filter(Boolean);
        const missing = deps.filter(d => !acceptedIds.has(d));
        if (missing.length > 0) {
          unsafeIndices.push(idx);
          audit.push({
            action: 'QUARANTINE_DEPENDENT_SERVICE',
            details: `${row.service_id} depends on quarantined/missing service(s): ${missing.join(', ')}`
          });
        }
      });

      if (unsafeIndices.length > 0) {
        const toMove = accepted.filter((_, idx) => unsafeIndices.includes(idx));
        toMove.forEach(m => {
          quarantine.push({ ...m, quarantine_reason: "Depends on a missing or quarantined service", raw_idx: "Cascade" });
        });
        accepted = accepted.filter((_, idx) => !unsafeIndices.includes(idx));
      }

      audit.unshift({ action: 'VALIDATION_SUMMARY', details: `Accepted ${accepted.length} row(s); quarantined ${quarantine.length} row(s)` });

      return { accepted, quarantine, audit };
    }

    // Engine: Simulation logic
    function runSimulation(cleanServices, budget) {
      if (cleanServices.length === 0) {
        return {
          recoveryList: [],
          timeline: [],
          summary: { restored_count: 0, total_count: 0, power_used_kw: 0, backup_budget_kw: budget, remaining_kw: budget }
        };
      }

      const dependencyMap = {};
      cleanServices.forEach(s => {
        const deps = (s.depends_on || '').split(',').map(d => d.trim()).filter(Boolean);
        dependencyMap[s.service_id] = deps;
      });

      let remainingIds = new Set(cleanServices.map(s => s.service_id));
      const restored = new Set();
      const results = {};
      const timeline = [];
      let used = 0.0;
      let stepNum = 1;

      while (remainingIds.size > 0) {
        const ready = [];
        cleanServices.forEach(row => {
          const sid = row.service_id;
          if (!remainingIds.has(sid)) return;
          const allDepsRestored = (dependencyMap[sid] || []).every(dep => restored.has(dep));
          if (allDepsRestored) {
            ready.push(row);
          }
        });

        const affordable = ready.filter(r => r.power_kw <= (budget - used + 1e-9));
        if (affordable.length === 0) break;

        // Sort by highest criticality, lower power, stable ID
        affordable.sort((a, b) => {
          if (b.criticality !== a.criticality) return b.criticality - a.criticality;
          if (a.power_kw !== b.power_kw) return a.power_kw - b.power_kw;
          return a.service_id.localeCompare(b.service_id);
        });

        const chosen = affordable[0];
        const sid = chosen.service_id;
        restored.add(sid);
        remainingIds.delete(sid);
        used += chosen.power_kw;
        results[sid] = "RESTORED";

        timeline.push({
          step: stepNum++,
          id: sid,
          name: chosen.service_name,
          power: chosen.power_kw,
          running_used: used,
          crit: chosen.criticality
        });
      }

      remainingIds.forEach(sid => {
        const allDepsRestored = (dependencyMap[sid] || []).every(dep => restored.has(dep));
        if (!allDepsRestored) {
          results[sid] = "WAITING_FOR_DEPENDENCY";
        } else {
          results[sid] = "INSUFFICIENT_BACKUP_POWER";
        }
      });

      const recoveryList = cleanServices.map(s => {
        const res = results[s.service_id];
        const score = (s.criticality / s.power_kw).toFixed(2);
        return {
          ...s,
          recovery_result: res,
          priority_score: parseFloat(score)
        };
      });

      recoveryList.sort((a, b) => {
        if (a.recovery_result !== b.recovery_result) {
          const order = { "RESTORED": 1, "INSUFFICIENT_BACKUP_POWER": 2, "WAITING_FOR_DEPENDENCY": 3 };
          return (order[a.recovery_result] || 4) - (order[b.recovery_result] || 4);
        }
        if (b.criticality !== a.criticality) return b.criticality - a.criticality;
        return a.power_kw - b.power_kw;
      });

      const summary = {
        restored_count: restored.size,
        total_count: cleanServices.length,
        power_used_kw: parseFloat(used.toFixed(2)),
        backup_budget_kw: parseFloat(budget.toFixed(2)),
        remaining_kw: parseFloat(Math.max(0, budget - used).toFixed(2))
      };

      return { recoveryList, timeline, summary };
    }

    // Render Dynamic SVG Topology
    function renderTopologySVG(cleanServices, recoveryResults, quarantineRecords) {
      const container = document.getElementById('topology-canvas-wrap');
      const statusMap = {};
      recoveryResults.forEach(r => { statusMap[r.service_id] = r.recovery_result; });
      quarantineRecords.forEach(q => { statusMap[q.service_id] = "QUARANTINED"; });

      const nodes = [
        { id: "PWR", name: "Backup Generator", x: 90, y: 120, kw: 1, crit: 5 },
        { id: "CLINIC", name: "First Aid Clinic", x: 270, y: 45, kw: 3, crit: 5, dep: "PWR" },
        { id: "COLD", name: "Medicine Fridge", x: 270, y: 120, kw: 2, crit: 5, dep: "PWR" },
        { id: "ACCESS", name: "Access Gates", x: 270, y: 195, kw: 2, crit: 4, dep: "PWR" },
        { id: "LIGHTS", name: "Area Lights", x: 450, y: 70, kw: 3, crit: 2, dep: "PWR" },
        { id: "WIFI", name: "Campus WiFi", x: 450, y: 170, kw: 4, crit: 3, dep: "PWR" }
      ];

      function getNodeColor(sid) {
        const st = statusMap[sid];
        if (st === "RESTORED") return { stroke: "#22c55e", fill: "rgba(34, 197, 94, 0.15)", text: "#16a34a" };
        if (st === "INSUFFICIENT_BACKUP_POWER") return { stroke: "#eab308", fill: "rgba(234, 179, 8, 0.12)", text: "#ca8a04" };
        if (st === "WAITING_FOR_DEPENDENCY") return { stroke: "#3b82f6", fill: "rgba(59, 130, 246, 0.12)", text: "#2563eb" };
        return { stroke: "#ef4444", fill: "rgba(239, 68, 68, 0.12)", text: "#dc2626" };
      }

      let svg = `<svg viewBox="0 0 540 240" class="w-full h-full">`;

      // Connectors
      nodes.forEach(n => {
        if (n.dep) {
          const parent = nodes.find(p => p.id === n.dep);
          if (parent) {
            const isLive = statusMap[n.id] === "RESTORED";
            const stroke = isLive ? "#22c55e" : "#64748b";
            const width = isLive ? 2.5 : 1.5;
            const dash = isLive ? "none" : "4,4";
            svg += `
              <path d="M ${parent.x + 44} ${parent.y} C ${(parent.x + n.x)/2} ${parent.y}, ${(parent.x + n.x)/2} ${n.y}, ${n.x - 44} ${n.y}" 
                    stroke="${stroke}" stroke-width="${width}" stroke-dasharray="${dash}" fill="none" opacity="${isLive ? 1 : 0.4}" />
            `;
          }
        }
      });

      // Nodes
      nodes.forEach(n => {
        const c = getNodeColor(n.id);
        const isLive = statusMap[n.id] === "RESTORED";
        const pulseClass = isLive ? 'powered-pulse' : '';
        svg += `
          <g transform="translate(${n.x}, ${n.y})" class="${pulseClass}">
            <rect x="-44" y="-22" width="88" height="44" rx="10" fill="var(--card)" stroke="${c.stroke}" stroke-width="2" />
            <text x="0" y="-4" text-anchor="middle" font-size="11" font-weight="bold" fill="var(--foreground)">${n.id}</text>
            <text x="0" y="10" text-anchor="middle" font-size="9" fill="${c.text}" font-weight="600">${n.kw}kW &bull; ${statusMap[n.id] || 'OFFLINE'}</text>
          </g>
        `;
      });

      svg += `</svg>`;
      container.innerHTML = svg;
    }

