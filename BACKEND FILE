    function executeAutoShieldPipeline() {
      const rows = parseCSV(activeAutoCSV);
      if (rows.length === 0) return;

      const headers = Object.keys(rows[0] || {});
      const idKey = headers.find(h => /id/i.test(h)) || headers[0];
      const dateKey = headers.find(h => /date|time/i.test(h));
      const metricKeys = headers.filter(h => h !== idKey && h !== dateKey);

      let detectedIssuesCount = 0;
      let repairsCount = 0;
      const audit = [];
      const quarantine = [];
      const accepted = [];
      const seenIds = new Set();

      rows.forEach((origRow, idx) => {
        const row = { ...origRow };
        const rawLineNum = idx + 2;
        let isQuarantined = false;
        let quarantineReason = "";
        let problemField = "";
        let problemValue = "";

        // 1. Safe Deterministic Repairs: Whitespace Trimming
        headers.forEach(col => {
          if (row[col] && typeof row[col] === 'string') {
            const rawVal = row[col];
            const trimmed = rawVal.trim();
            if (trimmed !== rawVal) {
              repairsCount++;
              detectedIssuesCount++;
              audit.push({ action: 'TRIM_WHITESPACE', details: `Row ${rawLineNum} col ${col}: trimmed whitespace` });
              row[col] = trimmed;
            }
          }
        });

        // 2. Validate Primary Identifier
        const idVal = row[idKey];
        if (!idVal || idVal.length === 0) {
          isQuarantined = true;
          detectedIssuesCount++;
          problemField = idKey;
          problemValue = "(missing/empty)";
          quarantineReason = "Missing mandatory primary identifier; violates audit traceability.";
        } else if (seenIds.has(idVal.toUpperCase())) {
          isQuarantined = true;
          detectedIssuesCount++;
          problemField = idKey;
          problemValue = idVal;
          quarantineReason = `Primary key collision: duplicate identifier '${idVal}' rejected.`;
        } else {
          seenIds.add(idVal.toUpperCase());
        }

        // 3. Validate Date / Timestamp
        if (!isQuarantined && dateKey && row[dateKey]) {
          const dtVal = row[dateKey];
          if (isNaN(Date.parse(dtVal))) {
            isQuarantined = true;
            detectedIssuesCount++;
            problemField = dateKey;
            problemValue = dtVal;
            quarantineReason = `Invalid timestamp format '${dtVal}'; fails ISO standard date validation.`;
          }
        }

        // 4. Validate Metrics & Numeric Fields (Exact problem value extraction)
        if (!isQuarantined) {
          for (let col of metricKeys) {
            const rawVal = row[col];
            const num = Number(rawVal);

            if (isNaN(num) || rawVal === "") {
              isQuarantined = true;
              detectedIssuesCount++;
              problemField = col;
              problemValue = rawVal || "(blank)";
              quarantineReason = `Non-numeric text '${rawVal}' cannot be safely converted to a number (zero-guess policy).`;
              break;
            }

            if (/pct|percent|attendance/i.test(col)) {
              if (num < 0 || num > 100) {
                isQuarantined = true;
                detectedIssuesCount++;
                problemField = col;
                problemValue = `${num}%`;
                quarantineReason = `Percentage value ${num}% is outside physical boundary (0 to 100%).`;
                break;
              }
            } else if (/voltage|volt/i.test(col)) {
              if (num < 0) {
                isQuarantined = true;
                detectedIssuesCount++;
                problemField = col;
                problemValue = `${num}V`;
                quarantineReason = `Negative voltage (${num}V) detected in positive AC bus line.`;
                break;
              } else if (num > 1000) {
                isQuarantined = true;
                detectedIssuesCount++;
                problemField = col;
                problemValue = `${num}V`;
                quarantineReason = `Voltage overload (${num}V) exceeds substation physical tolerance limits.`;
                break;
              }
            } else if (/freq/i.test(col)) {
              if (num < 47 || num > 53) {
                isQuarantined = true;
                detectedIssuesCount++;
                problemField = col;
                problemValue = `${num} Hz`;
                quarantineReason = `Grid frequency (${num} Hz) is outside safe operational frequency band (47-53 Hz).`;
                break;
              }
            } else if (/heart_rate|bpm/i.test(col)) {
              if (num < 20 || num > 300) {
                isQuarantined = true;
                detectedIssuesCount++;
                problemField = col;
                problemValue = `${num} bpm`;
                quarantineReason = `Heart rate (${num} bpm) is outside physiologically survivable bounds (20-300 bpm).`;
                break;
              }
            } else if (/spo2/i.test(col)) {
              if (num < 40 || num > 100) {
                isQuarantined = true;
                detectedIssuesCount++;
                problemField = col;
                problemValue = `${num}%`;
                quarantineReason = `SpO2 reading (${num}%) exceeds maximum 100% hemoglobin saturation.`;
                break;
              }
            } else {
              if (num < 0) {
                isQuarantined = true;
                detectedIssuesCount++;
                problemField = col;
                problemValue = `${num}`;
                quarantineReason = `Negative metric value (${num}) rejected by safety schema.`;
                break;
              }
            }

            row[col] = num;
          }
        }

        if (isQuarantined) {
          quarantine.push({
            ...origRow,
            raw_line: rawLineNum,
            record_id: idVal || `Row ${rawLineNum}`,
            faulty_field: problemField,
            problem_value: problemValue,
            quarantine_reason: quarantineReason
          });
          audit.push({ action: 'QUARANTINE_RECORD', details: `Row ${rawLineNum} (${idVal || 'No ID'}): ${quarantineReason}` });
        } else {
          accepted.push(row);
        }
      });

      autoAcceptedData = accepted;
      autoQuarantineData = quarantine;
      autoAuditLog = audit;

      // 1. Update Metrics Cards
      document.getElementById('as-raw-rows').innerText = rows.length;
      document.getElementById('as-raw-rows-sub').innerText = `${headers.length} columns parsed`;
      document.getElementById('as-detected-issues').innerText = detectedIssuesCount;
      document.getElementById('as-detected-sub').innerText = `${detectedIssuesCount} problems isolated/repaired`;
      document.getElementById('as-repairs-count').innerText = repairsCount;
      document.getElementById('as-repairs-sub').innerText = `${repairsCount} whitespace fields trimmed`;
      document.getElementById('as-quarantined-count').innerText = quarantine.length;
      document.getElementById('as-accepted-badge').innerText = `${accepted.length} valid`;
      document.getElementById('as-quarantine-badge').innerText = `${quarantine.length} isolated`;

      // 2. Update Verification Gate Banner
      const banner = document.getElementById('as-verification-banner');
      const icon = document.getElementById('as-gate-icon');
      const msg = document.getElementById('as-gate-message');
      const stat = document.getElementById('as-gate-status');

      if (quarantine.length === 0) {
        banner.className = "p-3.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-semibold";
        icon.innerText = "✓";
        msg.innerText = "100% Data Verification Passed: Zero anomalies detected. Dataset certified for operational use.";
        stat.innerText = `STATUS: CERTIFIED (${accepted.length}/${rows.length} Clean)`;
      } else {
        banner.className = "p-3.5 rounded-xl border border-amber-500/30 bg-amber-500/10 text-amber-700 dark:text-amber-400 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-semibold";
        icon.innerText = "🛡️";
        msg.innerText = `Verification Gate Active: ${repairsCount} safe repairs applied; ${quarantine.length} corrupted records safely isolated.`;
        stat.innerText = `STATUS: PROTECTED (${accepted.length} Clean &bull; ${quarantine.length} Quarantined)`;
      }

      // 3. Render Accepted Table Dynamically
      const thead = document.getElementById('as-accepted-thead');
      thead.innerHTML = `
        <tr class="border-b border-[var(--border)] text-[var(--muted-foreground)]">
          ${headers.map(h => `<th class="py-1.5 px-2">${h}</th>`).join('')}
        </tr>
      `;

      const tbodyAccepted = document.getElementById('as-accepted-table');
      if (accepted.length === 0) {
        tbodyAccepted.innerHTML = `<tr><td colspan="${headers.length}" class="py-3 px-2 text-center text-[var(--muted-foreground)]">All rows quarantined. No clean records accepted.</td></tr>`;
      } else {
        tbodyAccepted.innerHTML = accepted.map(a => `
          <tr class="hover:bg-[var(--border)]/10">
            ${headers.map((h, i) => {
              const val = a[h];
              const isId = (i === 0);
              const isMetric = typeof val === 'number';
              const cls = isId ? 'font-mono font-bold text-[var(--foreground)]' : (isMetric ? 'text-emerald-600 font-semibold' : 'text-[var(--muted-foreground)]');
              return `<td class="py-1.5 px-2 ${cls}">${val !== undefined ? val : ''}</td>`;
            }).join('')}
          </tr>
        `).join('');
      }

      // 4. Render Quarantined Table with Dynamic Exact Problem Values
      const tbodyQuarantine = document.getElementById('as-quarantine-table');
      if (quarantine.length === 0) {
        tbodyQuarantine.innerHTML = `<tr><td colspan="4" class="py-3 px-2 text-center text-emerald-600 font-medium">✓ Zero records quarantined. All input rows are valid.</td></tr>`;
      } else {
        tbodyQuarantine.innerHTML = quarantine.map(q => `
          <tr class="hover:bg-[var(--border)]/10">
            <td class="py-1.5 px-2 font-mono font-bold text-rose-500">${q.record_id}</td>
            <td class="py-1.5 px-2 font-mono text-[var(--muted-foreground)]">${q.faulty_field}</td>
            <td class="py-1.5 px-2">
              <span class="px-2 py-0.5 rounded bg-rose-500/20 text-rose-500 font-mono font-bold text-xs inline-block">
                ${q.problem_value}
              </span>
            </td>
            <td class="py-1.5 px-2 text-rose-600 font-medium">${q.quarantine_reason}</td>
          </tr>
        `).join('');
      }
    }

