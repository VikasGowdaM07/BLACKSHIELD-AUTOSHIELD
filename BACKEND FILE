      }
      const headers = Object.keys(autoAcceptedData[0]);
      const lines = [headers.join(',')];
      autoAcceptedData.forEach(r => {
        lines.push(headers.map(h => `"${r[h] !== undefined ? r[h] : ''}"`).join(','));
      });
      triggerDownload(lines.join('\n'), 'autoshield_accepted_clean.csv', 'text/csv');
    }

    function downloadAutoQuarantineCSV() {
      if (!autoQuarantineData || autoQuarantineData.length === 0) {
        alert("No quarantined records to export.");
