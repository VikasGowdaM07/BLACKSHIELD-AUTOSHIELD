      });
      triggerDownload(lines.join('\n'), 'autoshield_quarantined_proofs.csv', 'text/csv');
    }

    // Download helpers for BlackoutShield
    function triggerDownload(content, filename, type) {
      const blob = new Blob([content], { type });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.click();
      URL.revokeObjectURL(url);
    }

    function downloadCleanCSV() {
      if (!blackoutState) return;
      const headers = ["service_id", "service_name", "criticality", "power_kw", "status", "depends_on", "timestamp"];
      const lines = [headers.join(',')];
      blackoutState.accepted.forEach(r => {
